 750:Core/Src/main_DJI.c **** void DJI_Send(void)
 751:Core/Src/main_DJI.c **** {
 752:Core/Src/main_DJI.c ****   static CanSend_Type CANSend;
 753:Core/Src/main_DJI.c ****     
 754:Core/Src/main_DJI.c ****   // 大疆 1~4 号电机控制 ID 为 0x200
 755:Core/Src/main_DJI.c ****   CANSend.CANx = Arm_Motor[0].CAN_ID; // 这里传入的是 1 (代表 CAN1)
 756:Core/Src/main_DJI.c ****   CANSend.stdid = 0x200; 
 757:Core/Src/main_DJI.c **** 
 758:Core/Src/main_DJI.c ****   // 打包 1 号电机 (数据来自 Arm_Motor[0].Out)
 759:Core/Src/main_DJI.c ****   CANSend.Data[0] = (uint8_t)(Arm_Motor[0].Out >> 8);
 760:Core/Src/main_DJI.c ****   CANSend.Data[1] = (uint8_t)(Arm_Motor[0].Out & 0xFF);
 761:Core/Src/main_DJI.c ****     
 762:Core/Src/main_DJI.c ****   // 打包 2 号电机 (如果没有，就填 0)
 763:Core/Src/main_DJI.c ****   CANSend.Data[2] = (uint8_t)(Arm_Motor[1].Out >> 8);
 764:Core/Src/main_DJI.c ****   CANSend.Data[3] = (uint8_t)(Arm_Motor[1].Out & 0xFF);
 765:Core/Src/main_DJI.c ****     
 766:Core/Src/main_DJI.c ****   // 打包 3 号电机
 767:Core/Src/main_DJI.c ****   CANSend.Data[4] = (uint8_t)(Arm_Motor[2].Out >> 8);
