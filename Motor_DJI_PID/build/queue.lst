 247:Middlewares/Third_Party/FreeRTOS/Source/queue.c **** /*
 248:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  * Macro to mark a queue as locked.  Locking a queue prevents an ISR from
 249:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  * accessing the queue event lists.
 250:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  */
 251:Middlewares/Third_Party/FreeRTOS/Source/queue.c **** #define prvLockQueue( pxQueue )                            \
 252:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****     taskENTER_CRITICAL();                                  \
 253:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****     {                                                      \
 254:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         if( ( pxQueue )->cRxLock == queueUNLOCKED )        \
 255:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         {                                                  \
 256:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****             ( pxQueue )->cRxLock = queueLOCKED_UNMODIFIED; \
 257:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         }                                                  \
 258:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         if( ( pxQueue )->cTxLock == queueUNLOCKED )        \
 259:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         {                                                  \
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccfevJsw.s 			page 6


 260:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****             ( pxQueue )->cTxLock = queueLOCKED_UNMODIFIED; \
 261:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         }                                                  \
 262:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****     }                                                      \
 263:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****     taskEXIT_CRITICAL()
 264:Middlewares/Third_Party/FreeRTOS/Source/queue.c **** 
 265:Middlewares/Third_Party/FreeRTOS/Source/queue.c **** /*
 266:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  * Macro to increment cTxLock member of the queue data structure. It is
 267:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  * capped at the number of tasks in the system as we cannot unblock more
 268:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  * tasks than the number of tasks in the system.
 269:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  */
 270:Middlewares/Third_Party/FreeRTOS/Source/queue.c **** #define prvIncrementQueueTxLock( pxQueue, cTxLock )                           \
 271:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****     do {                                                                      \
 272:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         const UBaseType_t uxNumberOfTasks = uxTaskGetNumberOfTasks();         \
 273:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         if( ( UBaseType_t ) ( cTxLock ) < uxNumberOfTasks )                   \
 274:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         {                                                                     \
 275:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****             configASSERT( ( cTxLock ) != queueINT8_MAX );                     \
 276:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****             ( pxQueue )->cTxLock = ( int8_t ) ( ( cTxLock ) + ( int8_t ) 1 ); \
 277:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         }                                                                     \
 278:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****     } while( 0 )
 279:Middlewares/Third_Party/FreeRTOS/Source/queue.c **** 
 280:Middlewares/Third_Party/FreeRTOS/Source/queue.c **** /*
 281:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  * Macro to increment cRxLock member of the queue data structure. It is
 282:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  * capped at the number of tasks in the system as we cannot unblock more
 283:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  * tasks than the number of tasks in the system.
 284:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****  */
 285:Middlewares/Third_Party/FreeRTOS/Source/queue.c **** #define prvIncrementQueueRxLock( pxQueue, cRxLock )                           \
 286:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****     do {                                                                      \
 287:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         const UBaseType_t uxNumberOfTasks = uxTaskGetNumberOfTasks();         \
 288:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         if( ( UBaseType_t ) ( cRxLock ) < uxNumberOfTasks )                   \
 289:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         {                                                                     \
 290:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****             configASSERT( ( cRxLock ) != queueINT8_MAX );                     \
 291:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****             ( pxQueue )->cRxLock = ( int8_t ) ( ( cRxLock ) + ( int8_t ) 1 ); \
 292:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         }                                                                     \
 293:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****     } while( 0 )
